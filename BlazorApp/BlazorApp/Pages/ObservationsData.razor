@page "/observations"
@using System.Text.Json
@inject IJSRuntime jsRuntime

@inject NavigationManager Navigation
@using BrowserInterop.Extensions
@using BrowserInterop.Geolocation
@using Radzen
@using BlazorApp.Models

<h1>Creați o nouă observație</h1>
<div class="form-section">
    <div class="card p-4 mb-4">
        <h4>Informații generale</h4>
        <div class="mb-3">
            <label>Titlu</label>
            <input class="form-control" @bind="observation.Title" />
        </div>
        <div class="mb-3">
            <label>Descriere</label>
            <textarea class="form-control" @bind="observation.Description"></textarea>
        </div>
        <div class="mb-3">
            <label>Tipul cercetării</label>
            <select class="form-control" @bind="observation.ResearcherType">
                @foreach (var type in researcherTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Faza fenologică</label>
            <select class="form-control" @bind="observation.PhenologicalPhase">
                @foreach (var phase in phenologicalPhases)
                {
                    <option value="@phase">@phase</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Specii</label>
            <input class="form-control" @bind="observation.Species" />
        </div>
        <div class="mb-3">
            <label>Locație</label>
            <select class="form-control" @bind="observation.Location">
                @foreach (var loc in locations_list)
                {
                    <option value="@loc">@loc</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Notițe</label>
            <textarea class="form-control" @bind="observation.Notes"></textarea>
        </div>
        <div class="mb-3">
            <label>Temperatura (°C)</label>
            <input type="number" class="form-control" @bind="observation.Temperature" />
        </div>
        <div class="mb-3">
            <label>Umiditate (%)</label>
            <input type="number" class="form-control" @bind="observation.Humidity" />
        </div>
        <div class="mb-3">
            <label>Stare atmosferică</label>
            <select class="form-control" @bind="observation.Weather">
                @foreach (var condition in weatherConditions)
                {
                    <option value="@condition">@condition</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label>Detalii suplimentare</label>
            <textarea class="form-control" @bind="observation.AdditionalDetails"></textarea>
        </div>
    </div>
    @if (observation.MicroObservations.Any())
    {
        <div class="card p-4 mb-4">
            <h4>Previzualizare micro observații</h4>
            @foreach (var micro in observation.MicroObservations)
            {
                <div class="border p-2 mb-2">
                    <p><strong>Animal:</strong> @micro.Animal.Name (@micro.Animal.ScientificName)</p>
                    <p><strong>Locaţie:</strong> LAT: @micro.Latitude, LNG: @micro.Longitude</p>
                    <p><strong>Comentarii:</strong> @micro.Comments</p>
                    @if (!string.IsNullOrEmpty(micro.PhotoUrl))
                    {
                        <img src="@micro.PhotoUrl" style="width: 100px;" alt="animal photo" />
                    }
                </div>
            }
        </div>
    }
    @if (!showMicroForm)
    {
        <button class="btn btn-secondary mb-3" @onclick="() => showMicroForm = true">➕ Add New Micro Observation</button>
    }
    else
    {
        <div class="card p-4 mb-4">
            <h4>Adaugă Micro Observație</h4>

            <div class="mb-3">
                <label>Numele animalului</label>
                <input class="form-control" @bind="currentMicro.Animal.Name" />
            </div>
            <div class="mb-3">
                <label>Nume științific</label>
                <input class="form-control" @bind="currentMicro.Animal.ScientificName" />
            </div>
            <div class="mb-3">
                <label>Descriere</label>
                <textarea class="form-control" @bind="currentMicro.Animal.Description"></textarea>
            </div>
            <div class="mb-3">
                <label>Categorie</label>
                <select class="form-control" @bind="currentMicro.Animal.Category">
                    @foreach (var category in animalCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label>Notițe</label>
                <textarea class="form-control" @bind="currentMicro.Animal.Notes"></textarea>
            </div>
            <div class="mb-3">
                <button class="btn btn-info me-2" @onclick="UseCurrentLocation">📍 Utilizează locația curentă</button>
                <button class="btn btn-secondary" @onclick="EnableMapSelection">🗺️ Selectează locația pe hartă</button>
            </div>

            @if (selectedPosition != null)
            {
                <p><strong>Selected Location:</strong> @clickedLocationText</p>
            }

            @if (showMap)
            {
                <RadzenGoogleMap Style="height:400px;" Zoom="@zoom"
                                 Center="@(new GoogleMapPosition { Lat = 47.0, Lng = 28.5 })"
                                 MapClick="@OnMapClick">
                    <Markers>
                        @if (selectedPosition != null)
                        {
                            <RadzenGoogleMapMarker Title="Selected Location"
                                                   Label="📍"
                                                   Position="@selectedPosition" />
                        }
                    </Markers>
                </RadzenGoogleMap>
            }

            <div class="mb-3">
                <label>Comentarii</label>
                <textarea class="form-control" @bind="currentMicro.Comments"></textarea>
            </div>
            <div class="mb-3">
                <label>Photo URL (Base64 or link)</label>
                <input class="form-control" @bind="currentMicro.PhotoUrl" />
            </div>
            <button class="btn btn-secondary" @onclick="AddMicroObservation">Salvați Micro Observație</button>
        </div>
    }
</div>

<div class="center-button">
    <button class="btn btn-primary" @onclick="SaveObservation">Trimiteți observația</button>
</div>


<style>
    
    body {
        margin: 0;
        color: #f5f3cd;
        padding: 0;
