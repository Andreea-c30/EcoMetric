@code {
    private List<string> researcherTypes = new() { "Migrația păsărilor", "Migrația cuiburilor", "Migrația habitatelor", "Altele" };
    private List<string> phenologicalPhases = new() {  "Emergență", "Începerea migrației","Sfârșitul migrației", "Împerechere / Reproducere","Cuibărit / Depunere de ouă", "Eclozare / Naștere", "Dezvoltare juvenilă","Năpârlire / Schimbare a pielii",    "Activitate maximă",    "Hrănire / Căutare de hrană",    "Hibernare / Repaus",    "Stabilirea teritoriului",  "Evenimente de mortalitate" };
    private List<string> weatherConditions = new() { "Soare", "Înorat", "Ploios", "Furtunos", "Ninsoare", "Vântos" };
    private List<string> animalCategories = new() { "Pasăre", "Mamifer", "Insectă", "Reptilă", "Amfibian", "Pește", "Altele" };
    private List<string> locations_list = new() { "r. Anenii Noi, s. Hîrbovăț", "r. Anenii Noi, s. Bulboaca", "r. Anenii Noi, s. Telița", "r. Briceni, s. Caracușenii Vechi", "r. Briceni, s. Corjeuți ", "r. Călărași, s. Căbăiești ", "r. Călărași, s. Sadova ", "r. Călărași, s. Rassvet " };
    private bool showMicroForm = false;
    private WindowNavigatorGeolocation geolocation;
    private GeolocationPosition? geolocationPosition;
    private bool isUsingCurrentLocation = false;
    private bool isLocationConfirmed = false;
    private bool showMap = false;
    private string clickedLocationText = "";
    private GoogleMapPosition? selectedPosition = null;
    private string locationError = "";
    int zoom = 6;
    private Observation observation = new();
    private MicroObservation currentMicro = new();
    protected override async Task OnInitializedAsync()
    {
        var window = await jsRuntime.Window();
        var navigator = await window.Navigator();
        geolocation = navigator.Geolocation;
    }

    private void AddMicroObservation()
    {
        currentMicro.Timestamp = DateTime.Now;
        observation.MicroObservations.Add(currentMicro);
        currentMicro = new MicroObservation(); // reset form
        selectedPosition = null;
        clickedLocationText = "";
        showMicroForm = false; // hide form
    }

    private async Task UseCurrentLocation()
    {
        geolocationPosition = (await geolocation.GetCurrentPosition(new PositionOptions()
            {
                EnableHighAccuracy = true,
                TimeoutTimeSpan = TimeSpan.FromSeconds(30)
            })).Location;

        if (geolocationPosition != null)
        {
            selectedPosition = new GoogleMapPosition
                {
                    Lat = geolocationPosition.Coords.Latitude,
                    Lng = geolocationPosition.Coords.Longitude
                };

            currentMicro.Latitude = selectedPosition.Lat;
            currentMicro.Longitude = selectedPosition.Lng;
            clickedLocationText = $"LAT: {selectedPosition.Lat}, LNG: {selectedPosition.Lng}";
            isLocationConfirmed = true;
            showMap = false;
        }
    }

    private void EnableMapSelection()
    {
        showMap = true;
        selectedPosition = null;
        clickedLocationText = "";
        isLocationConfirmed = false;
    }

    private void OnMapClick(GoogleMapClickEventArgs args)
    {
        selectedPosition = new GoogleMapPosition { Lat = args.Position.Lat, Lng = args.Position.Lng };
        currentMicro.Latitude = args.Position.Lat;
        currentMicro.Longitude = args.Position.Lng;
        clickedLocationText = $"LAT: {args.Position.Lat}, LNG: {args.Position.Lng}";
        isLocationConfirmed = true;
        StateHasChanged();
    }


    private async Task SaveObservation()
    {
        observation.MicroObservations ??= new List<MicroObservation>();

        var existingJson = await jsRuntime.InvokeAsync<string>("localStorage.getItem", "observations");

        var observations = string.IsNullOrEmpty(existingJson)
            ? new List<Observation>()
            : JsonSerializer.Deserialize<List<Observation>>(existingJson) ?? new List<Observation>();

        observations.Add(observation);

        var updatedJson = JsonSerializer.Serialize(observations);
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", "observations", updatedJson);

        // Reset
        observation = new Observation();
        currentMicro = new MicroObservation();

        // Navigate back to dashboard
        Navigation.NavigateTo("/home");
    }
    public class Observation
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ResearcherType { get; set; } = "";
        public string PhenologicalPhase { get; set; } = "";
        public string Species { get; set; } = "";
        public string Location { get; set; } = "";
        public string Notes { get; set; } = "";
        public List<string> PhotoUrls { get; set; } = new();
        public string Comments { get; set; } = "";
        public double Temperature { get; set; }
        public double Humidity { get; set; }
        public string Weather { get; set; } = "";
        public string AdditionalDetails { get; set; } = "";
        public List<MicroObservation> MicroObservations { get; set; } = new();
    }

    public class MicroObservation
    {
        public Animal Animal { get; set; } = new();
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public DateTime Timestamp { get; set; }
        public string Comments { get; set; } = "";
        public string PhotoUrl { get; set; } = "";
    }

    public class Animal
    {
        public string Name { get; set; } = "";
        public string ScientificName { get; set; } = "";
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public string Notes { get; set; } = "";
    }

}