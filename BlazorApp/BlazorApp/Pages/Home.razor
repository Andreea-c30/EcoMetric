@code {
    private List<Observation> allObservations = new();

    protected override async Task OnInitializedAsync()
    {
        var json = await jsRuntime.InvokeAsync<string>("localStorage.getItem", "observations");

        if (!string.IsNullOrEmpty(json))
        {
            allObservations = JsonSerializer.Deserialize<List<Observation>>(json) ?? new();
        }
    }
    private async void ViewObservation(Observation obs)
    {
        var json = JsonSerializer.Serialize(obs);
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", "selectedObservation", json);
        NavigationManager.NavigateTo($"/observation-details");
    }
    private async Task DeleteObservation(Observation obs)
    {
        var confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Sigur doriți să ștergeți observația „{obs.Title}”?");
        if (!confirmed)
            return;

        allObservations.Remove(obs);

        var json = JsonSerializer.Serialize(allObservations);
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", "observations", json);

        StateHasChanged();
    }

    private void EditObservation(Observation obs)
    {
        var json = JsonSerializer.Serialize(obs);
        jsRuntime.InvokeVoidAsync("localStorage.setItem", "selectedObservation", json);
        NavigationManager.NavigateTo("/edit-observation");
    }

    private void SortObservations(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();

        switch (selected)
        {
            case "date_desc":
                allObservations = allObservations
                    .OrderByDescending(o => o.MicroObservations.FirstOrDefault()?.Timestamp)
                    .ToList();
                break;

            case "date_asc":
                allObservations = allObservations
                    .OrderBy(o => o.MicroObservations.FirstOrDefault()?.Timestamp)
                    .ToList();
                break;

            case "title_asc":
                allObservations = allObservations
                    .OrderBy(o => o.Title)
                    .ToList();
                break;

            case "title_desc":
                allObservations = allObservations
                    .OrderByDescending(o => o.Title)
                    .ToList();
                break;
        }

        StateHasChanged();
    }

    public class Observation
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string ResearcherType { get; set; } = "";
        public string PhenologicalPhase { get; set; } = "";
        public string Species { get; set; } = "";
        public string Location { get; set; } = "";
        public string Notes { get; set; } = "";
        public List<string> PhotoUrls { get; set; } = new();
        public string Comments { get; set; } = "";
        public double Temperature { get; set; }
        public double Humidity { get; set; }
        public string Weather { get; set; } = "";
        public string AdditionalDetails { get; set; } = "";
        public List<MicroObservation> MicroObservations { get; set; } = new();
    }

    public class MicroObservation
    {
        public Animal Animal { get; set; } = new();
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public DateTime Timestamp { get; set; }
        public string Comments { get; set; } = "";
        public string PhotoUrl { get; set; } = "";
    }

    public class Animal
    {
        public string Name { get; set; } = "";
        public string ScientificName { get; set; } = "";
        public string Description { get; set; } = "";
        public string Category { get; set; } = "";
        public string Notes { get; set; } = "";
    }
}