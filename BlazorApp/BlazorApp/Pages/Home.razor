@page "/home"
@inject IJSRuntime jsRuntime
@using System.Text.Json
@inject NavigationManager NavigationManager



<PageTitle>Homepage</PageTitle>

<h1 class="dashboard-title">Bun venit la tabloul de bord</h1>

<div class="dashboard-container">
    <DashboardCard ImageSrc="/images/observ.png"
                   ButtonText="Începe observația"
                   Link="/observations" />

    <DashboardCard ImageSrc="/images/report.png"
                   ButtonText="Rapoarte și statistici"
                   Link="/chartpg" />
</div>

@if (allObservations?.Any() == true)
{
    <div class="observation-header">
        <h2 class="observation-title">Observații curente</h2>
        <div class="sort-box">
            <i class="bi bi-filter-square-fill filter-icon"></i>
            <select id="sortOptions" @onchange="SortObservations" class="sort-select">
                <option value="date_desc">Data - Cele mai noi</option>
                <option value="date_asc">Data - Cele mai vechi</option>
                <option value="title_asc">Titlu - A-Z</option>
                <option value="title_desc">Titlu - Z-A</option>
            </select>
        </div>
    </div>




    <div class="dashboard-container">
        @foreach (var obs in allObservations)
        {
           <div class="dashboard-card2">
                <div class="card-header">
                    <div></div>
                    <div class="card-actions">
                        <h2>@obs.Title</h2>
                        <button class="icon-btn edit" @onclick="@(() => EditObservation(obs))" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </button>

                        <button class="icon-btn delete" @onclick="() => DeleteObservation(obs)" title="Delete">

                            <i class="bi bi-trash"></i>
                        </button>

                    </div>
                </div>
                <div class="card-body" @onclick="@(() => ViewObservation(obs))" style="cursor: pointer;">
                   
                    <p><strong>Specii:</strong> @obs.Species</p>
                    <p><strong>Tempeperatura:</strong> @obs.Temperature °C</p>
                    <p><strong>Stare atmosferică:</strong> @obs.Weather</p>
                </div>
            </div>
        }
    </div>
}

